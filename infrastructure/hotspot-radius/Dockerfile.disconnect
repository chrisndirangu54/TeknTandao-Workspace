FROM node:22-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends freeradius-utils ca-certificates && rm -rf /var/lib/apt/lists/*
WORKDIR /srv
COPY package.json /srv/package.json
RUN npm install --omit=dev --ignore-scripts --no-audit --no-fund
COPY disconnect-worker.mjs /srv/disconnect-worker.mjs
USER node
CMD ["node","/srv/disconnect-worker.mjs"]
