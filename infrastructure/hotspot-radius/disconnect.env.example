# Local private NAS disconnect worker. Keep credentials out of Git.
HOTSPOT_ORG_ID=org_example1
HOTSPOT_SITE_ID=site_example1
HOTSPOT_NAS_ID=nas_example1
HOTSPOT_NAS_PRIVATE_IP=10.0.0.2
HOTSPOT_NAS_SECRET_FILE=/run/secrets/radius_disconnect_secret
HOTSPOT_DISCONNECT_ENABLED=false
GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/firebase-service-account.json
