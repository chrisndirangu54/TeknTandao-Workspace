# Copy to a private .env file, not Git. Never expose the bridge port publicly.
HOTSPOT_ACCOUNTING_URL=https://europe-west1-YOUR_WORKSPACE_PROJECT.cloudfunctions.net/hotspotV2RadiusAccounting
HOTSPOT_AUTHORIZATION_URL=https://europe-west1-YOUR_WORKSPACE_PROJECT.cloudfunctions.net/hotspotV2RadiusAuthorize
HOTSPOT_RADIUS_BRIDGE_HMAC_KEY=REPLACE_WITH_SITE_SECRET_RETURNED_BY_hotspotV2RotateBridgeKey
HOTSPOT_ORG_ID=org_example1
HOTSPOT_SITE_ID=site_example1
HOTSPOT_NAS_ID=nas_example1
HOTSPOT_BRIDGE_HOST=0.0.0.0
HOTSPOT_BRIDGE_PORT=8080
