rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function member(org) {
      return request.auth != null && exists(/databases/$(database)/documents/organizations/$(org)/members/$(request.auth.uid));
    }
    function owner(org) {
      return member(org) && get(/databases/$(database)/documents/organizations/$(org)/members/$(request.auth.uid)).data.role == 'owner';
    }
    function access(org, app) {
      let m = get(/databases/$(database)/documents/organizations/$(org)/members/$(request.auth.uid)).data;
      let a = get(/databases/$(database)/documents/organizations/$(org)/apps/$(app)).data;
      return member(org) && (m.role == 'owner' || app in m.apps) && a.expiresAt > request.time;
    }
    function genericAppCollection(app) {
      return app.matches('^mc[0-9][0-9]_.+$') || app in [
        'social', 'livechat', 'events', 'surveys', 'wms', 'quality',
        'expenses', 'subscriptions', 'assets', 'payroll', 'recruitment',
        'lms', 'knowledge', 'contracts', 'discussions', 'analytics',
        'vault', 'desk_phone', 'agri', 'freight', 'legal', 'microfinance',
        'attendance', 'time'
      ];
    }
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
    }

    // Published runtime snapshots are public single-document reads only. Domain
    // ownership, tenant mappings, analytics identities and provider metadata are
    // intentionally not public Firestore surfaces.
    match /publishedWebsiteSites/{siteId} {
      allow get: if true;
      allow list: if false;
    }
    match /publishedWebsiteDomains/{domain} { allow read: if false; }
    match /websitePublicSiteOwners/{siteId} { allow read: if false; }
    match /websitePlugins/{pluginId} { allow read: if false; }
    match /websiteFormRateLimits/{id} { allow read: if false; }

    match /organizations/{org} {
      allow read: if member(org);
      match /members/{uid} { allow read: if member(org) && request.auth.uid == uid; }
      match /apps/{app} { allow read: if member(org); }
      match /modules/{app}/records/{id} { allow read: if access(org, app); }
      match /contacts/{id} { allow read: if access(org, 'crm') || access(org, 'pos'); }
      match /products/{id} { allow read: if access(org, 'inventory') || access(org, 'pos'); }
      match /sales/{id} { allow read: if access(org, 'pos') || access(org, 'accounting'); }
      match /invoices/{id} { allow read: if access(org, 'accounting'); }
      match /tasks/{id} { allow read: if access(org, 'crm'); }
      match /employees/{id} { allow read: if access(org, 'hr'); }
      match /projects/{id} { allow read: if access(org, 'projects'); }
      match /tickets/{id} { allow read: if access(org, 'helpdesk'); }
      match /patients/{id} { allow read: if access(org, 'hospital'); }
      match /students/{id} { allow read: if access(org, 'school'); }
      match /properties/{id} { allow read: if access(org, 'property'); }
      match /sacco_members/{id} { allow read: if access(org, 'sacco'); }
      match /etims_logs/{id} { allow read: if access(org, 'etims') || access(org, 'accounting'); }

      match /marketing_campaigns/{id} { allow read: if access(org, 'marketing'); }
      match /appointments/{id} { allow read: if access(org, 'bookings'); }
      match /ecommerce_orders/{id} { allow read: if access(org, 'ecommerce'); }
      match /procurement_pos/{id} { allow read: if access(org, 'procurement'); }
      match /work_orders/{id} { allow read: if access(org, 'manufacturing'); }
      match /field_dispatches/{id} { allow read: if access(org, 'fieldservice'); }
      match /fleet_trips/{id} { allow read: if access(org, 'fleet'); }
      match /hotel_rooms/{id} { allow read: if access(org, 'hotel'); }
      match /restaurant_orders/{id} { allow read: if access(org, 'restaurant'); }
      match /grants/{id} { allow read: if access(org, 'ngo'); }
      match /documents/{id} { allow read: if access(org, 'documents'); }

      // Website Builder: collaborators can read the live authoring model, CMS,
      // assets and collaboration presence. Infrastructure, submissions,
      // analytics, AI plans and immutable release history are owner-only.
      match /websiteProjects/{id} { allow read: if access(org, 'mc14_website_builder'); }
      match /websiteTemplateEntitlements/{id} { allow read: if access(org, 'mc14_website_builder'); }
      match /websiteAssets/{id} { allow read: if access(org, 'mc14_website_builder'); }
      match /websiteCmsCollections/{id} {
        allow read: if access(org, 'mc14_website_builder');
        match /entries/{entryId} { allow read: if access(org, 'mc14_website_builder'); }
      }
      match /websitePluginInstalls/{id} { allow read: if access(org, 'mc14_website_builder'); }
      match /websiteCollaboration/{projectId} {
        allow read: if access(org, 'mc14_website_builder');
        match /ops/{opId} { allow read: if access(org, 'mc14_website_builder'); }
        match /presence/{actorId} { allow read: if access(org, 'mc14_website_builder'); }
      }
      match /websiteProjectEvents/{id} { allow read: if owner(org); }
      match /websiteVersions/{id} { allow read: if owner(org); }
      match /websiteTemplateEarnings/{id} { allow read: if owner(org); }
      match /websiteDomains/{id} { allow read: if owner(org); }
      match /websiteAssetUploads/{id} { allow read: if owner(org); }
      match /websiteExperiments/{id} { allow read: if owner(org); }
      match /websiteExperimentStats/{id} { allow read: if owner(org); }
      match /websiteAnalyticsDaily/{id} { allow read: if owner(org); }
      match /websiteFormSubmissions/{id} { allow read: if owner(org); }
      match /websiteFormSpam/{id} { allow read: if owner(org); }
      match /websiteFormStats/{id} { allow read: if owner(org); }
      match /websiteCreatorPayoutProfiles/{id} { allow read: if owner(org); }
      match /websiteCreatorPayouts/{id} { allow read: if owner(org); }
      match /websiteAiPlans/{id} { allow read: if owner(org); }
      match /websiteAiActionRequests/{id} { allow read: if owner(org); }

      // Cross-app graph, automation, agent, AI-cost and sync metadata can expose
      // data from multiple installed apps. Direct client reads therefore remain
      // owner-only; scoped member mutations are served through callable APIs.
      match /businessGraphNodes/{id} { allow read: if owner(org); }
      match /businessGraphEdges/{id} { allow read: if owner(org); }
      match /eventBus/{id} { allow read: if owner(org); }
      match /automationRules/{id} { allow read: if owner(org); }
      match /automationRuns/{id} { allow read: if owner(org); }
      match /agents/{id} { allow read: if owner(org); }
      match /agentApprovals/{id} { allow read: if owner(org); }
      match /agentPermits/{id} { allow read: if owner(org); }
      match /agentExecutions/{id} { allow read: if owner(org); }
      match /agentAudit/{id} { allow read: if owner(org); }
      match /agentUsage/{id} { allow read: if owner(org); }
      match /syncReceipts/{id} { allow read: if owner(org); }
      match /aiUsage/{id} { allow read: if owner(org); }
      match /aiFinOpsConfig/{id} { allow read: if owner(org); }

      match /reports/{id} { allow read: if owner(org); }
      match /payments/{id} { allow read: if owner(org); }
      match /{app}/{id} {
        allow read: if genericAppCollection(app) && access(org, app);
      }
    }
    match /{document=**} { allow write: if false; }
  }
}
