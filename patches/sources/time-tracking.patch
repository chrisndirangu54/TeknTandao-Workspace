diff --git a/lib/src/utils/time_api.dart b/lib/src/utils/time_api.dart
new file mode 100644
--- /dev/null
+++ b/lib/src/utils/time_api.dart
@@ -0,0 +1,15 @@
+import 'package:cloud_functions/cloud_functions.dart';
+
+class TimeApi {
+  static const orgId = String.fromEnvironment('TANDAO_ORG_ID');
+  static String path(String uid, String collection) {
+    if (!RegExp(r'^[A-Za-z0-9_-]+$').hasMatch(orgId)) throw StateError('Set TANDAO_ORG_ID to use the shared time tracking module');
+    return 'organizations/$orgId/timeMembers/$uid/$collection';
+  }
+  static Future<void> mutate(String kind, String action, String id, [Map<String, dynamic>? record]) async {
+    path('validation', kind);
+    await FirebaseFunctions.instanceFor(region: 'europe-west1').httpsCallable('mutateTimeRecord').call({
+      'orgId': orgId, 'kind': kind, 'action': action, 'id': id, if (record != null) 'record': record,
+    });
+  }
+}
