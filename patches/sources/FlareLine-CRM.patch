+import 'dart:async';
+import 'package:donor_firebase/donor_auth.dart';
+import 'package:flutter/material.dart';
+import 'package:flutter_test/flutter_test.dart';
+import 'package:flareline_crm/pages/auth/sign_in/sign_in_viewmodel.dart';
+import 'package:flareline_crm/pages/auth/sign_up/sign_up_viewmodel.dart';
+
+class FakeAuth implements DonorAuthenticator {
+  int attempts = 0;
+  String? password;
+  bool fail = false;
+  Completer<void>? pending;
+  @override
+  Future<void> signIn(String email, String value) async {
+    attempts++;
+    password = value;
+    if (fail) throw StateError('Invalid credentials');
+    if (pending != null) await pending!.future;
+  }
+  @override
+  Future<void> register(String email, String value) => signIn(email, value);
+  @override
+  Future<void> resetPassword(String email) async { attempts++; }
+  @override
+  Future<void> signInWithProvider(String provider) async { attempts++; }
+}
+
+void main() {
+  late BuildContext context;
+  Future<void> mount(WidgetTester tester) => tester.pumpWidget(MaterialApp(home: Builder(builder: (value) { context = value; return const SizedBox(); })));
+
+  testWidgets('login has no demo credentials and reports Firebase failure', (tester) async {
+    await mount(tester);
+    final auth = FakeAuth()..fail = true;
+    final model = SignInViewModel(context, authenticator: auth);
+    expect(model.emailController.text, isEmpty);
+    expect(model.passwordController.text, isEmpty);
+    model.emailController.text = 'person@example.test';
+    model.passwordController.text = ' correct spaces ';
+    await model.signIn();
+    expect(auth.password, ' correct spaces ');
+    expect(model.state.loginStatus, false);
+    expect(model.state.busy, false);
+    expect(model.state.message, contains('Invalid credentials'));
+    await model.close();
+  });
+
+  testWidgets('duplicate submits are ignored until Firebase completes', (tester) async {
+    await mount(tester);
+    final auth = FakeAuth()..pending = Completer<void>();
+    final model = SignInViewModel(context, authenticator: auth);
+    model.emailController.text = 'person@example.test';
+    model.passwordController.text = 'password';
+    final first = model.signIn();
+    await model.signIn();
+    expect(auth.attempts, 1);
+    expect(model.state.loginStatus, isNull);
