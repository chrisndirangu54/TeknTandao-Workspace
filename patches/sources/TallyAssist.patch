diff --git a/test/date_forms_test.dart b/test/date_forms_test.dart
new file mode 100644
--- /dev/null
+++ b/test/date_forms_test.dart
@@ -0,0 +1,52 @@
+import 'package:firebase_auth/firebase_auth.dart';
+import 'package:flutter/material.dart';
+import 'package:flutter_test/flutter_test.dart';
+import 'package:intl/intl.dart';
+import 'package:provider/provider.dart';
+import 'package:tassist/ui/widgets/productionForm.dart';
+import 'package:tassist/ui/widgets/khataScreen/khataform.dart';
+
+void main() {
+  testWidgets('khata requires a transaction type without throwing',
+      (tester) async {
+    await tester.pumpWidget(Provider<FirebaseUser>.value(
+      value: null,
+      child: MaterialApp(home: Scaffold(body: KhataForm())),
+    ));
+    await tester.tap(find.text('Submit'));
+    await tester.pump();
+    expect(find.text('Please select a type'), findsOneWidget);
+    expect(tester.takeException(), isNull);
+  });
+  for (final name in ['production', 'khata']) {
+    testWidgets('$name date selection updates and survives cancellation',
+        (tester) async {
+      await tester.pumpWidget(Provider<FirebaseUser>.value(
+        value: null,
+        child: MaterialApp(
+          home: Scaffold(
+            body: name == 'production' ? ProductionForm() : KhataForm(),
+          ),
+        ),
+      ));
+      expect(find.text('Select a date'), findsOneWidget);
+      await tester.tap(find.text('Date Picker'));
+      await tester.pumpAndSettle();
+      expect(tester.takeException(), isNull);
+      expect(find.byType(DatePickerDialog), findsOneWidget);
+      final selected = tester
+          .widget<DatePickerDialog>(find.byType(DatePickerDialog))
+          .initialDate;
+      await tester.tap(find.text('OK'));
+      await tester.pumpAndSettle();
+      final expected = DateFormat('dd-MM-yyyy').format(selected);
+      expect(find.text(expected), findsOneWidget);
+      await tester.tap(find.text('Date Picker'));
+      await tester.pumpAndSettle();
+      await tester.tap(find.text('CANCEL'));
+      await tester.pumpAndSettle();
+      expect(find.text(expected), findsOneWidget);
+      expect(tester.takeException(), isNull);
+    });
+  }
+}
