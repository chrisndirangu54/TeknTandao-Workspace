+import 'dart:convert';
+import 'package:firebase_auth/firebase_auth.dart';
+import 'package:flutter_test/flutter_test.dart';
+import 'package:provider/provider.dart';
+import 'package:tassist/main.dart';
+import 'package:tassist/templates/invoice_pdf_template.dart';
+import 'package:tassist/templates/ledgeraccount_pdf_template.dart';
+
+void main() {
+  testWidgets('signed-out startup does not open account data streams',
+      (tester) async {
+    await tester.pumpWidget(Provider<User?>.value(
+      value: null,
+      child: const TopWidget(),
+    ));
+    await tester.pumpAndSettle();
+    expect(find.text('Start Now!'), findsOneWidget);
+    expect(tester.takeException(), isNull);
+  });
+
+  test('invoice renders through the current PDF package', () async {
+    final document = createInvoicePdf(
+      companyName: 'Test Company',
+      companyAddress: 'Nairobi',
+      companyPincode: '00100',
+      partyName: 'Customer',
+      partyAddress: 'Nairobi',
+      partyPincode: '00100',
+      partyState: 'Nairobi',
+      partyGST: '',
+      invoiceNumber: 'INV-001',
+      invoiceDate: '29-09-2026',
+      itemList: [
+        ['Item', 'Amount'],
+        ['Service', '100']
+      ],
+    );
+    final bytes = await document.save();
+    expect(ascii.decode(bytes.sublist(0, 5)), '%PDF-');
+    expect(bytes.length, greaterThan(1000));
+  });
+
+  test('ledger statement renders through the current PDF package', () async {
+    final document = createLedgerPdf(
+      companyName: 'Test Company',
+      partyName: 'Customer',
+      startDate: '01-09-2026',
+      endDate: '29-09-2026',
+      openingBalance: '0',
+      closingBalance: '100',
+      ledgerList: [
+        ['Date', 'Amount'],
+        ['29-09-2026', '100']
+      ],
+    );
+    final bytes = await document.save();
+    expect(ascii.decode(bytes.sublist(0, 5)), '%PDF-');
+    expect(bytes.length, greaterThan(1000));
+  });
+}
