+import 'dart:typed_data';
+import 'package:share_plus/share_plus.dart';
+
+class DocumentShare {
+  static Future<void> files(
+      String title, Map<String, Uint8List> files, String mimeType,
+      {String? text}) async {
+    await Share.shareXFiles(
+      files.entries
+          .map((entry) => XFile.fromData(entry.value,
+              name: entry.key, mimeType: 'application/pdf'))
+          .toList(),
+      fileNameOverrides: files.keys.toList(),
+      subject: title,
+      text: text,
+    );
+  }
+}
